# Litigation Management System - Environment Configuration
# Copy this file to .env and update with your actual values

# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_URL=http://lit.local:8080

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=litigation_db
DB_USER=root
DB_PASS=your_password_here

# Security Configuration (IMPORTANT: Generate secure values for production)
JWT_SECRET=your_long_random_secret_key_here_minimum_32_characters

# Email Configuration (Optional)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=your_email_user
SMTP_PASS=your_email_password
SMTP_FROM_EMAIL=noreply@litigation.com
SMTP_FROM_NAME=Litigation Management System

# File Upload Configuration
UPLOAD_MAX_SIZE=52428800
UPLOAD_PATH=uploads/

# Cache Configuration
CACHE_ENABLED=true
CACHE_LIFETIME=3600

# Logging Configuration
LOG_ENABLED=true
LOG_LEVEL=INFO

# Business Configuration
DEFAULT_CURRENCY=EGP
VAT_RATE=0.14
DEFAULT_TIMEZONE=Asia/Riyadh
DEFAULT_LANGUAGE=ar

# Security Note:
# - Never commit the actual .env file to version control
# - Use strong, unique values for JWT_SECRET in production
# - Ensure database credentials are secure
# - Review all configuration values before deployment