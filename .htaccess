RewriteEngine On

# Handle API routes through backend API
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^api/(.*)$ backend/api/index.php [QSA,L]

# Handle backend API routes directly
RewriteCond %{REQUEST_URI} ^/backend/api/
RewriteRule ^backend/api/(.*)$ backend/api/index.php [QSA,L]

# Handle all other requests to index.html for SPA
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [QSA,L]
